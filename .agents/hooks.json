{
  "external-project-write-guard": {
    "PreToolUse": [
      {
        "matcher": "edit_file|write_file|replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONDONTWRITEBYTECODE=1 python3 ./hooks/pre_tool_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "goal-verify-stop-gate": {
    "Stop": [
      {
        "type": "command",
        "command": "PYTHONDONTWRITEBYTECODE=1 python3 ./hooks/stop_verify_gate.py",
        "timeout": 120
      }
    ]
  },
  "auto-gg-workflow": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "PYTHONDONTWRITEBYTECODE=1 python3 ./hooks/auto_gg_hook.py --event pre_invocation",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "exit_plan_mode",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONDONTWRITEBYTECODE=1 python3 ./hooks/auto_gg_hook.py --event pre_tool",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONDONTWRITEBYTECODE=1 python3 ./hooks/auto_gg_hook.py --event post_tool",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "PYTHONDONTWRITEBYTECODE=1 python3 ./hooks/auto_gg_hook.py --event stop",
        "timeout": 10
      }
    ]
  }
}
